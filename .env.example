# ===== Risk model =====
# keyword | tfidf | wangchanberta
RISK_MODEL=keyword
# path ของโมเดล (tfidf: ไฟล์ .joblib, wangchanberta: โฟลเดอร์ที่ได้จากการเทรน)
MODEL_PATH=models/wangchanberta-risk

# จำนวนข้อความล่าสุดที่ใช้ตัดสิน (Sliding Window) และจำนวนคำสูงสุด
N_TURNS=3
MAX_TOKENS=256

# เกณฑ์ความน่าจะเป็น (ตั้ง CRITICAL ต่ำ = เน้น Recall)
CRITICAL_THRESHOLD=0.35
WARNING_THRESHOLD=0.5

# ===== Session =====
SESSION_MAX_TURNS=10
SESSION_TTL_SECONDS=1800
# เปลี่ยนเป็นค่าสุ่มยาวๆ — ใช้ hash LINE userId ก่อนเก็บ
USER_ID_SALT=change-me

# ===== LINE Messaging API =====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

